# ============================================================
# .env.example - 환경 변수 "견본" 파일
#
# 사용법: 이 파일을 복사해 .env 라는 이름으로 만들고, 값을 채운다.
#   PowerShell>  Copy-Item .env.example .env
#
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않는다.
# 이 견본 파일(.env.example)에는 진짜 키를 절대 적지 않는다.
# ============================================================

# OpenRouter API 키 (https://openrouter.ai/keys 에서 발급, sk-or-v1- 로 시작)
OPENROUTER_API_KEY=

# scripts/ask_ai.py 가 사용할 모델. (에이전트 OpenCode 의 모델은 opencode.jsonc 에서 정한다)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# PostgreSQL 계정 (실습용 값. 그대로 두면 된다)
POSTGRES_USER=memo
POSTGRES_PASSWORD=memo1234
POSTGRES_DB=memo_db
