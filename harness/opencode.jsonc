// ============================================================
// opencode.jsonc - AI 에이전트(OpenCode) 설정 파일  [완성본: 권한 규칙 포함]
//
// 하네스의 "권한" 담당. AGENTS.md 가 "부탁"이라면 이 파일은 "잠금장치"다.
// 에이전트가 규칙을 잊거나 어겨도, 여기서 deny 한 일은 실행되지 않는다.
//
// 규칙 읽는 법
//   action   : 무엇을 하려는가   (shell = 명령 실행, edit = 파일 고치기, read = 파일 읽기 ...)
//   resource : 무엇에 대해서인가 (* 는 "아무 글자나"라는 뜻)
//   effect   : allow(그냥 허용) / ask(사람에게 물어봄) / deny(금지)
//
// 위에서 아래로 읽으며, 여러 규칙에 걸리면 "가장 아래 규칙"이 이긴다.
// 그래서 넓은 규칙을 위에, 예외를 아래에 적는다.
// ============================================================
{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/anthropic/claude-haiku-5.5",
  "share": "disabled",

  "permissions": [
    // ---------- 1. 명령 실행(shell) ----------
    // 기본값: 모든 명령은 실행 전에 사람에게 물어본다.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // 검증에 필요한 명령과, 읽기만 하는 명령은 묻지 않고 허용한다.
    { "action": "shell", "resource": "sh scripts/verify.sh *", "effect": "allow" },
    { "action": "shell", "resource": "pytest *", "effect": "allow" },
    { "action": "shell", "resource": "ruff check *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },

    // 저장(commit)과 올리기(push)는 사람만 한다. 에이전트는 금지.
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    // 되돌리기 어려운 명령도 금지.
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },

    // ---------- 2. 파일 고치기(edit) ----------
    // app, tests 폴더는 자유롭게 고칠 수 있다(기본값이 allow).
    // 아래 파일들은 "하네스 자체"이므로 에이전트가 고치지 못한다.
    // (시험 보는 사람이 채점 기준을 고칠 수 없는 것과 같다)
    { "action": "edit", "resource": "*AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "*opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "*/harness/*", "effect": "deny" },
    { "action": "edit", "resource": "*/scripts/verify.sh", "effect": "deny" },
    { "action": "edit", "resource": "*/.githooks/*", "effect": "deny" },
    { "action": "edit", "resource": "*/checkpoints/*", "effect": "deny" },
    // checkpoints 폴더(교시별 완성 예시)는 읽지도 못한다. 답을 베끼지 않고 요구사항을 보고 만들게 한다.
    { "action": "read", "resource": "*/checkpoints/*", "effect": "deny" },
    // 실행 환경 파일은 고치기 전에 사람에게 물어본다.
    { "action": "edit", "resource": "*Dockerfile", "effect": "ask" },
    { "action": "edit", "resource": "*docker-compose*.yml", "effect": "ask" },
    { "action": "edit", "resource": "*requirements.txt", "effect": "ask" },

    // ---------- 3. 비밀 값(.env) ----------
    // API 키가 들어 있는 .env 는 읽지도 고치지도 못한다. 견본(.env.example)은 읽어도 된다.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // ---------- 4. 인터넷 ----------
    // 웹 페이지를 가져오거나 검색하기 전에는 사람에게 물어본다.
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" }
  ]
}
