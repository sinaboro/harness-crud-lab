# Git 에 올리지 않을 것들

# 비밀 값(API 키, 비밀번호). 견본(.env.example)만 올린다.
.env
.env.*
!.env.example

# PostgreSQL 데이터 폴더 (내 PC 에만 있으면 된다)
data/

# DB 백업 파일
backup/

# 파이썬·도구가 만드는 임시 파일
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/

# 편집기 설정
.vscode/
.idea/

# 교안 PDF 를 만들 때 생기는 중간 파일
tools/_build/
